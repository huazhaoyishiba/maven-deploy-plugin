<idea-plugin>
    <id>com.mcp.deploy</id>
    <name>Maven Deploy</name>
    <vendor email="machuang@example.com" url="https://github.com/machuang">zhuyafei</vendor>

    <description><![CDATA[
    <h2>Maven 打包自动部署插件</h2>
    <p>监听 Maven 打包完成事件，打包成功后自动通过 SSH 将 jar 文件上传到远程服务器。</p>

    <h3>功能特性</h3>
    <ul>
      <li>支持多服务器配置，每台独立开关</li>
      <li>Maven 打包成功自动上传到所有已开启的服务器</li>
      <li>右侧面板列表管理 + 新建/编辑表单双视图</li>
      <li>手动勾选多台服务器一键上传</li>
      <li>SSH 密码认证 + 密钥认证双模式</li>
      <li>自动读取 jar 名称</li>
      <li>上传后可执行远程命令（如重启服务）</li>
    </ul>

    <h3>使用方法</h3>
    <ol>
      <li>右侧边栏打开 <b>Maven Deploy</b> 面板</li>
      <li>点击 <b>新建</b>，填写服务器 SSH 信息</li>
      <li>在列表中勾选「自动」列（或留空仅手动上传）</li>
      <li>执行 Maven 打包 → 自动上传到所有勾选的服务器</li>
      <li>或勾选列表行 → 点击「上传选中」手动触发</li>
    </ol>
    ]]></description>

    <!-- 兼容版本范围 -->
    <idea-version since-build="203" until-build="242.*"/>

    <!-- 依赖模块 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.idea.maven</depends>

    <!-- 扩展点 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 右侧边栏 Tool Window -->
        <toolWindow
            id="Maven Deploy"
            anchor="right"
            icon="AllIcons.Toolwindows.ToolWindowCommit"
            factoryClass="com.mcp.deploy.settings.MavenDeployToolWindowFactory"/>

        <!-- 持久化服务 -->
        <projectService
            serviceImplementation="com.mcp.deploy.settings.MavenDeploySettings"/>

        <!-- 通知组 -->
        <notificationGroup id="Maven Deploy"
            displayType="BALLOON"
            isLogByDefault="true"/>
    </extensions>

    <!-- 应用组件 -->
    <applicationListeners>
        <listener
            topic="com.intellij.execution.ExecutionListener"
            class="com.mcp.deploy.listener.MavenDeployExecutionListener"
            activeInTestMode="false"/>
    </applicationListeners>
</idea-plugin>
